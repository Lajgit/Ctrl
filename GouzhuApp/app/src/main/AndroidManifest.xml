<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />

    <!-- RK3566 量产系统应用连接指定 WiFi 所需的系统权限。 -->
    <uses-permission android:name="android.permission.NETWORK_SETTINGS" />
    <uses-permission android:name="android.permission.OVERRIDE_WIFI_CONFIG" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GouzhuApp"
        android:usesCleartextTraffic="true">

        <provider
            android:name=".serial.BoardConnectionInitProvider"
            android:authorities="${applicationId}.board-connection-init"
            android:enabled="true"
            android:exported="false" />

        <activity
            android:name=".network.WifiConfigActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="portrait" />

        <activity
            android:name=".BackendSettingsActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ActivationActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="portrait" />

        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait" />

        <activity
            android:name=".redemption.RedemptionActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="portrait" />

        <activity
            android:name=".payment.PaymentQrActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:finishOnTaskLaunch="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.GouzhuApp.PaymentDialog" />

        <activity
            android:name=".ControllerFaultActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:finishOnTaskLaunch="false"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.GouzhuApp.ControllerFault" />

        <service
            android:name=".service.DeviceService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
            仅接收本应用内部的MQTT状态广播。MQTT断线立即关闭现金；重连后先保持关闭，
            等首次心跳/状态上报后的bootstrap重新确认cashSale.available。
        -->
        <receiver
            android:name=".mqtt.MqttOnlineStatusReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.gouzhu.action.SERVICE_STATUS" />
            </intent-filter>
        </receiver>

        <!--
            库存为0、库存数变化或K1补珠后作废旧cashSale.available并重新请求bootstrap。
            这里只更新现金运行门控，不修改MQTT现金配置版本或档位。
        -->
        <receiver
            android:name=".mqtt.CashInventoryRuntimeReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.gouzhu.action.BOARD_EVENT" />
            </intent-filter>
        </receiver>

        <!--
            K1补珠确认后原子清除可恢复的物理/现金/本地复位门禁，并把部分出珠会话
            转为“等待继续出珠”。同时监听交易占用和出珠事件，保证进程重建及人工结案
            后状态仍能正确恢复；这里只维护状态，不会自动继续出珠。
        -->
        <receiver
            android:name=".mqtt.RefillStateReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.gouzhu.action.BOARD_EVENT" />
                <action android:name="com.gouzhu.action.TRANSACTION_OCCUPANCY_CHANGED" />
                <action android:name="com.gouzhu.action.DISPENSE_ORDER_EVENT" />
            </intent-filter>
        </receiver>

        <!-- 接收统一购珠状态广播，打开双支付入口窗口；取消、关闭、支付确认或异常时同步关闭。 -->
        <receiver
            android:name=".payment.PaymentQrPopupReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.gouzhu.action.PAYMENT_EVENT" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".boot.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>