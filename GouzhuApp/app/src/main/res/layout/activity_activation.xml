<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="36dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/activation_title"
            android:textColor="@color/text_primary"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/activation_hint"
            android:textColor="@color/text_secondary"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_status_panel"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:id="@+id/image_activation_qr"
                android:layout_width="360dp"
                android:layout_height="360dp"
                android:contentDescription="@string/activation_qr_description"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/text_activation_qr_unavailable"
                android:layout_width="360dp"
                android:layout_height="180dp"
                android:gravity="center"
                android:text="@string/activation_qr_waiting"
                android:textColor="@color/text_hint"
                android:textSize="17sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/text_activation_claim_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="@string/activation_claim_code_waiting"
                android:textColor="@color/header_primary"
                android:textIsSelectable="true"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_activation_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/activation_waiting"
            android:textColor="@color/text_secondary"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/text_activation_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_status_panel"
            android:padding="18dp"
            android:textColor="#B42318"
            android:textIsSelectable="true"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/text_activation_device"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:textColor="@color/text_hint"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/text_activation_identity_registration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_status_panel"
            android:padding="18dp"
            android:textColor="@color/text_secondary"
            android:textIsSelectable="true"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/activation_page_log_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/activation_page_log_hint"
            android:textColor="@color/text_hint"
            android:textSize="14sp" />

        <ScrollView
            android:id="@+id/scroll_activation_log"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_status_panel"
            android:fillViewport="true"
            android:padding="14dp">

            <TextView
                android:id="@+id/text_activation_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="@string/activation_log_empty"
                android:textColor="@color/text_secondary"
                android:textIsSelectable="true"
                android:textSize="13sp" />
        </ScrollView>

        <Button
            android:id="@+id/button_copy_activation_log"
            style="@style/Widget.Gouzhu.ActionButton"
            android:layout_width="match_parent"
            android:layout_marginTop="12dp"
            android:text="@string/activation_page_copy_log" />
    </LinearLayout>
</ScrollView>
