<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B3000000"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="44dp"
        android:layout_marginEnd="44dp"
        android:background="@drawable/bg_controller_fault_card"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="38dp"
        android:paddingTop="34dp"
        android:paddingEnd="38dp"
        android:paddingBottom="34dp">

        <TextView
            android:layout_width="82dp"
            android:layout_height="82dp"
            android:background="@drawable/bg_controller_fault_icon"
            android:gravity="center"
            android:text="!"
            android:textColor="@color/white"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:text="@string/controller_fault_title"
            android:textColor="@color/text_primary"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_controller_fault_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.25"
            android:text="@string/controller_fault_message"
            android:textColor="@color/text_secondary"
            android:textSize="19sp" />

        <ProgressBar
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_marginTop="24dp"
            android:indeterminate="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/controller_fault_reconnecting"
            android:textColor="@color/header_primary"
            android:textSize="17sp" />
    </LinearLayout>
</FrameLayout>
