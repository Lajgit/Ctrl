<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/page_background"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="36dp"
            android:paddingTop="34dp"
            android:paddingEnd="36dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="@drawable/bg_header"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="32dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/header_title"
                        android:textColor="@color/white"
                        android:textSize="38sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/header_subtitle"
                        android:textColor="@color/header_subtitle"
                        android:textSize="22sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:background="@drawable/bg_header_badge"
                    android:gravity="center"
                    android:text="@string/header_badge_text"
                    android:textColor="@color/header_primary"
                    android:textSize="54sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_package_section_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/package_section_title"
                android:textColor="@color/text_primary"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_package_section_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="@string/package_section_hint"
                android:textColor="@color/text_secondary"
                android:textSize="17sp" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:columnCount="3"
                android:rowCount="2">

                <Button android:id="@+id/button_package_1" style="@style/Widget.Gouzhu.PackageButton" android:text="--" />
                <Button android:id="@+id/button_package_5" style="@style/Widget.Gouzhu.PackageButton" android:text="--" />
                <Button android:id="@+id/button_package_10" style="@style/Widget.Gouzhu.PackageButton" android:text="--" />
                <Button android:id="@+id/button_package_20" style="@style/Widget.Gouzhu.PackageButton" android:text="--" />
                <Button android:id="@+id/button_package_50" style="@style/Widget.Gouzhu.PackageButton" android:text="--" />
                <Button android:id="@+id/button_package_100" style="@style/Widget.Gouzhu.PackageButton" android:text="--" />
            </GridLayout>

            <TextView
                android:id="@+id/text_selected_package"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_selected_package"
                android:gravity="center"
                android:padding="16dp"
                android:text="@string/package_not_selected"
                android:textColor="@color/header_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/button_start_payment"
                style="@style/Widget.Gouzhu.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_marginTop="18dp"
                android:text="@string/start_payment" />

            <!--
                二维码和取消入口只允许显示在独立的 PaymentQrActivity 弹窗中。
                保留零尺寸兼容节点，避免旧 MainActivity 字节码或迟到广播访问空控件。
            -->
            <ImageView
                android:id="@+id/image_payment_qr"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:contentDescription="@string/payment_qr_description"
                android:visibility="gone" />

            <com.gouzhu.widget.SafePaymentCancelButton
                android:id="@+id/button_cancel_payment"
                style="@style/Widget.Gouzhu.ActionButton"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:enabled="false"
                android:text="@string/payment_cancel_button"
                android:visibility="gone" />

            <TextView
                android:id="@+id/text_payment_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/payment_select_package"
                android:textColor="@color/text_secondary"
                android:textSize="18sp" />

            <LinearLayout
                android:id="@+id/layout_collection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_selected_package"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/collection_title"
                    android:textColor="@color/text_primary"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_collection_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/collection_ready_hint"
                    android:textColor="@color/text_secondary"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/button_collection_start"
                        style="@style/Widget.Gouzhu.PrimaryButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/collection_start" />

                    <Button
                        android:id="@+id/button_collection_finish"
                        style="@style/Widget.Gouzhu.ActionButton"
                        android:layout_width="0dp"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:enabled="false"
                        android:text="@string/collection_finish" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/button_backend_settings"
                style="@style/Widget.Gouzhu.ActionButton"
                android:layout_width="220dp"
                android:layout_marginTop="28dp"
                android:text="@string/backend_debug_entry" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/layout_dispense_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="36dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progress_dispense_order"
            android:layout_width="82dp"
            android:layout_height="82dp"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/text_dispense_overlay_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/dispense_order_started"
            android:textColor="@color/white"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_dispense_overlay_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="@string/dispense_order_waiting"
            android:textColor="@color/white"
            android:textSize="22sp" />
    </LinearLayout>
</FrameLayout>