<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="36dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/backend_title"
            android:textColor="@color/text_primary"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/backend_hint"
            android:textColor="@color/text_secondary"
            android:textSize="17sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_status_panel"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:id="@+id/text_network_status"
                style="@style/Widget.Gouzhu.StatusText"
                android:text="@string/network_waiting" />

            <TextView
                android:id="@+id/text_mqtt_status"
                style="@style/Widget.Gouzhu.StatusText"
                android:text="@string/mqtt_waiting" />

            <TextView
                android:id="@+id/text_board_status"
                style="@style/Widget.Gouzhu.StatusText"
                android:text="@string/board_waiting" />

            <TextView
                android:id="@+id/text_stock_status"
                style="@style/Widget.Gouzhu.StatusText"
                android:text="@string/stock_unknown" />

            <TextView
                android:id="@+id/text_pending_status"
                style="@style/Widget.Gouzhu.StatusText"
                android:text="@string/pending_status_unknown" />

            <TextView
                android:id="@+id/text_latest_event"
                style="@style/Widget.Gouzhu.StatusText"
                android:text="@string/latest_event_waiting" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_device_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="@color/text_hint"
            android:textSize="14sp" />

        <Button
            android:id="@+id/button_wifi_settings"
            style="@style/Widget.Gouzhu.ActionButton"
            android:layout_width="match_parent"
            android:layout_marginTop="24dp"
            android:text="@string/wifi_settings" />

        <Button
            android:id="@+id/button_refresh_status"
            style="@style/Widget.Gouzhu.ActionButton"
            android:layout_width="match_parent"
            android:layout_marginTop="14dp"
            android:text="@string/refresh_status" />

        <Button
            android:id="@+id/button_activation_logs"
            style="@style/Widget.Gouzhu.ActionButton"
            android:layout_width="match_parent"
            android:layout_marginTop="14dp"
            android:text="@string/activation_log_button" />

        <Button
            android:id="@+id/button_exit_backend"
            style="@style/Widget.Gouzhu.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_marginTop="20dp"
            android:text="@string/exit_backend" />
    </LinearLayout>
</ScrollView>
