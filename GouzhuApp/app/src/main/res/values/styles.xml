<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.Gouzhu.PackageButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">118dp</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:background">@drawable/bg_package_button</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">23sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@null</item>
        <item name="cornerRadius">20dp</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.Gouzhu.StatusText" parent="@android:style/Widget.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="Widget.Gouzhu.ActionButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_height">58dp</item>
        <item name="android:background">@drawable/bg_action_button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/button_secondary_text</item>
        <item name="android:textSize">18sp</item>
        <item name="backgroundTint">@null</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.Gouzhu.PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_height">62dp</item>
        <item name="android:background">@drawable/bg_primary_button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">19sp</item>
        <item name="backgroundTint">@null</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.Gouzhu.SecondaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_height">62dp</item>
        <item name="android:background">@drawable/bg_action_button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/button_secondary_text</item>
        <item name="android:textSize">19sp</item>
        <item name="backgroundTint">@null</item>
        <item name="elevation">0dp</item>
    </style>
</resources>
