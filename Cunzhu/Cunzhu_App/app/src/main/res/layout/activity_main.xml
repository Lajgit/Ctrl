<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chuzhu_page_bg"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="18dp"
        android:paddingEnd="22dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="自助存珠系统"
                    android:textColor="@color/chuzhu_primary_dark"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="SELF SERVICE DEPOSIT MACHINE"
                    android:textColor="@color/chuzhu_panel_blue"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_header_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/chuzhu_accent"
                android:paddingStart="12dp"
                android:paddingTop="7dp"
                android:paddingEnd="12dp"
                android:paddingBottom="7dp"
                android:text="初始化"
                android:textColor="@color/chuzhu_text_main"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="@color/chuzhu_panel_blue"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/chuzhu_panel_blue"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/text_main_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="请使用微信扫描二维码"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@color/chuzhu_card_bg"
                    android:padding="18dp">

                    <ImageView
                        android:id="@+id/image_qr"
                        android:layout_width="220dp"
                        android:layout_height="220dp"
                        android:layout_gravity="center"
                        android:adjustViewBounds="true"
                        android:background="@color/white"
                        android:contentDescription="会员存珠二维码"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:id="@+id/text_qr_placeholder"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:gravity="center"
                        android:text="正在获取二维码"
                        android:textColor="@color/chuzhu_text_sub"
                        android:textSize="16sp" />
                </FrameLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_refresh_session"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="主动刷新二维码"
                    android:textColor="@color/chuzhu_text_main"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/chuzhu_accent" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/chuzhu_card_bg"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:strokeColor="#1A0887CF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/DebugSectionTitle"
                    android:text="会员信息" />

                <TextView
                    android:id="@+id/text_member_no"
                    style="@style/DebugText"
                    android:text="会员：等待扫码" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/text_member_balance"
                        style="@style/DebugText"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="余额：-" />

                    <TextView
                        android:id="@+id/text_member_limit"
                        style="@style/DebugText"
                        android:layout_width="0dp"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="上限：-" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_actual_quantity"
                    style="@style/DebugText"
                    android:layout_marginTop="8dp"
                    android:text="本次已确认：0 颗" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/chuzhu_card_bg"
            app:cardCornerRadius="18dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/DebugSectionTitle"
                    android:text="存珠状态" />

                <TextView
                    android:id="@+id/text_session_state"
                    style="@style/DebugText"
                    android:text="会话：未创建" />

                <TextView
                    android:id="@+id/text_operation_no"
                    style="@style/DebugText"
                    android:text="业务单号：-" />

                <TextView
                    android:id="@+id/text_device_status"
                    style="@style/DebugText"
                    android:text="设备：初始化" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_start_deposit"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:text="开始存珠"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="@color/chuzhu_accent"
            android:textColor="@color/chuzhu_text_main" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_cancel_session"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="返回待机" />

        <TextView
            android:id="@+id/text_last_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/chuzhu_error_bg"
            android:padding="12dp"
            android:text=""
            android:textColor="@color/chuzhu_error_text"
            android:textSize="13sp" />
    </LinearLayout>

</ScrollView>
